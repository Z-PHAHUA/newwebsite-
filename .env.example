# ---- Database -------------------------------------------------------------
# Local Postgres (default sandbox):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Supabase Postgres: Supabase Dashboard → Project Settings → Database →
# Connection string → "Transaction pooler" (port 6543). SSL is enabled automatically.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---- Supabase Auth (customer login/register) ----------------------------------
# Supabase Dashboard → Project Settings → API. When both are set, customer
# accounts use Supabase Auth; otherwise a local email/password fallback is used.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Admin panel ------------------------------------------------------------
ADMIN_EMAIL=admin@vogue.store
ADMIN_PASSWORD=admin123
ADMIN_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SITE_URL=
